<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<style>
  :root {
    --bg: #f7f7f5; --surface: #ffffff; --text: #1d1d1b; --muted: #5f5f5a; --border: #e2e1dc;
    --ok: #1f7a4d; --ok-bg: #e5f3ec; --bad: #b42318; --bad-bg: #fbe9e7; --warn: #8a5a00; --warn-bg: #fdf3dc;
    --accent: #2457c5; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615; --surface: #201f1d; --text: #ecebe6; --muted: #a3a29b; --border: #34332f;
      --ok: #5cc794; --ok-bg: #173527; --bad: #f2877a; --bad-bg: #3d1f1b; --warn: #e9b949; --warn-bg: #3a2f14;
      --accent: #8fb0ff;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1180px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 26px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 17px; margin: 36px 0 12px; }
  .meta { color: var(--muted); font-size: 13px; }
  .meta code { font-family: var(--mono); font-size: 12px; }
  .verdict { display: inline-block; padding: 3px 10px; border-radius: 999px; font-weight: 600; font-size: 13px;
             margin-left: 10px; vertical-align: 4px; }
  .verdict.ok { background: var(--ok-bg); color: var(--ok); }
  .verdict.bad { background: var(--bad-bg); color: var(--bad); }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-top: 24px; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .tile .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
  .tile .value { font-size: 26px; font-weight: 650; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .tile .sub { color: var(--muted); font-size: 12px; }
  .tile.bad .value { color: var(--bad); } .tile.ok .value { color: var(--ok); } .tile.warn .value { color: var(--warn); }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em;
       background: var(--surface); position: sticky; top: 0; }
  tr:last-child td { border-bottom: none; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  code, .mono { font-family: var(--mono); font-size: 12px; overflow-wrap: anywhere; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .pill.bad { background: var(--bad-bg); color: var(--bad); }
  .pill.warn { background: var(--warn-bg); color: var(--warn); }
  .pill.ok { background: var(--ok-bg); color: var(--ok); }
  .bar { height: 8px; border-radius: 4px; background: var(--accent); opacity: 0.8; }
  .empty { color: var(--muted); padding: 16px; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<main>
{% block content %}{% endblock %}
<footer>Generated by customs-event-test-harness at {{ generated_at }}. Synthetic test data only.</footer>
</main>
</body>
</html>
